---
/**
 * About page: built only from site.config.ts values. Anything the owner has
 * not confirmed renders as a highlighted [NEEDS DATA] marker; no facts are
 * invented.
 */
import Layout from "../components/Layout.astro";
import PageHero from "../components/PageHero.astro";
import ContentProse from "../components/ContentProse.astro";
import { site } from "../lib/site";

const telHref = `tel:${site.phoneNumber.replace(/[^\d+]/g, "")}`;
const isPlaceholder = (value: string) => /^[A-Z0-9_]+$/.test(value);
const fact = (value: string, label: string) => (isPlaceholder(value) ? `[NEEDS DATA: ${label}]` : value);
---

<Layout
  title={`About ${site.businessName}`}
  fullTitle={`About ${site.businessName} | Water Softener Installation in ${site.city}, ${site.stateAbbr}`}
  description={`About ${site.businessName}: water softener installation, replacement, repair and water testing for ${site.city}, ${site.stateAbbr} and the South Plains.`}
>
  <PageHero
    breadcrumbs={[{ label: "About" }]}
    heading={`About ${site.businessName}`}
    primaryCta={{ href: telHref, text: `📞 ${site.phoneNumber}` }}
    secondaryCta={{ href: "#estimate", text: "Get a Free Estimate" }}
  >
    <p slot="opening">
      {site.businessName} installs, replaces and services water softeners and water treatment systems for homes
      and businesses in {site.city}, {site.stateAbbr} and nearby South Plains towns.
    </p>
  </PageHero>

  <section class="section">
    <div class="container">
      <ContentProse>
        <h2>Who We Are</h2>
        <p>
          {site.businessName} serves {site.city} homeowners whose water comes from the Ogallala Aquifer and
          nearby lakes. Our work covers softener installation and replacement, repair and maintenance, filtration,
          reverse osmosis and water testing.
        </p>

        <h2>Key Facts</h2>
        <table>
          <thead><tr><th>Fact</th><th>Detail</th></tr></thead>
          <tbody>
            <tr><td>Founder or team</td><td set:html={fact(site.founderNames, "founder or team names").replace(/\[(.*)\]/, '<mark class="data-gap">[$1]</mark>')} /></tr>
            <tr><td>Year founded</td><td set:html={fact(site.foundedYear, "year founded").replace(/\[(.*)\]/, '<mark class="data-gap">[$1]</mark>')} /></tr>
            <tr><td>Customers served</td><td set:html={fact(site.customersServed, "customers served").replace(/\[(.*)\]/, '<mark class="data-gap">[$1]</mark>')} /></tr>
            <tr><td>Water treatment licence</td><td><mark class="data-gap">[NEEDS DATA: TCEQ Water Treatment Specialist licence number]</mark></td></tr>
            <tr><td>Service area</td><td>{site.city}, {site.county} and nearby South Plains towns</td></tr>
          </tbody>
        </table>
      </ContentProse>
    </div>
  </section>
</Layout>
